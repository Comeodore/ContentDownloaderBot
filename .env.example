# ── Bot ────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Max output file size in MB: 50 without a local Bot API server, up to 2000 with one.
MAX_FILE_SIZE_MB=49

# Optional cookies.txt path. In Docker: /var/lib/telegram-bot-api/cookies.txt
COOKIES_FILE=

# Owner's Telegram user id: only they can upload cookies.txt, and they get
# expired-cookie notices.
OWNER_ID=

# Restart every N hours to update yt-dlp (0 = off). Docker only.
YTDLP_AUTO_UPDATE_HOURS=24

# Host data dir (downloads + Bot API server data), mounted into both containers.
CONTENTDL_DATA_DIR=./data

# ── Local Telegram Bot API server (files up to 2 GB) ──
# In docker-compose: http://telegram-bot-api:8081. Empty = api.telegram.org (50 MB).
TELEGRAM_API_BASE=

# From https://my.telegram.org → API development tools; local server only.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Watch queue (owner only, see README) ──
# Channel ids look like -1001234567890: the t.me/c/<id>/... link's id with -100 in front.
WATCH_CHANNEL_ID=
# Daily batch time and its time zone (empty = only when Next is pressed).
WATCH_DAILY_AT=
WATCH_TZ=Europe/Kyiv
